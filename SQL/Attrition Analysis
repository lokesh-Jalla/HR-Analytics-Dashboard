------------------------------------------------------------
-- Query 1 : Overall Attrition Rate
------------------------------------------------------------
SELECT
    COUNT(*) AS TotalEmployees,
    SUM(CASE WHEN Attrition = 1 THEN 1 ELSE 0 END) AS AttritionCount,
    ROUND(
        SUM(CASE WHEN Attrition = 1 THEN 1.0 ELSE 0 END)
        *100/COUNT(*),2
    ) AS AttritionRate
FROM HR_Employee;


------------------------------------------------------------
-- Query 2 : Attrition by Gender
------------------------------------------------------------
SELECT
    Gender,
    COUNT(*) AS AttritionEmployees
FROM HR_Employee
WHERE Attrition = 1
GROUP BY Gender
ORDER BY AttritionEmployees DESC;


