------------------------------------------------------------
-- Query 1 : Top 3 Highest Paid Employees in Each Department
------------------------------------------------------------
WITH SalaryRank AS
(
    SELECT
        EmployeeNumber,
        Department,
        JobRole,
        MonthlyIncome,
        ROW_NUMBER() OVER
        (
            PARTITION BY Department
            ORDER BY MonthlyIncome DESC
        ) AS SalaryRank
    FROM HR_Employee
)
SELECT *
FROM SalaryRank
WHERE SalaryRank <= 3;


------------------------------------------------------------
-- Query 2 : Rank Employees by Salary
------------------------------------------------------------
SELECT
    EmployeeNumber,
    JobRole,
    MonthlyIncome,
    RANK() OVER
    (
        ORDER BY MonthlyIncome DESC
    ) AS SalaryRank
FROM HR_Employee;


------------------------------------------------------------
-- Query 3 : Dense Rank Employees by Salary
------------------------------------------------------------
SELECT
    EmployeeNumber,
    JobRole,
    MonthlyIncome,
    DENSE_RANK() OVER
    (
        ORDER BY MonthlyIncome DESC
    ) AS DenseSalaryRank
FROM HR_Employee;


------------------------------------------------------------
-- Query 4 : Employees Earning More Than Department Average
------------------------------------------------------------
SELECT
    EmployeeNumber,
    Department,
    JobRole,
    MonthlyIncome
FROM HR_Employee E
WHERE MonthlyIncome >
(
    SELECT AVG(MonthlyIncome)
    FROM HR_Employee
    WHERE Department = E.Department
);


------------------------------------------------------------
-- Query 5 : Department with Highest Average Salary
------------------------------------------------------------
SELECT TOP 1
    Department,
    ROUND(AVG(MonthlyIncome),2) AS AverageSalary
FROM HR_Employee
GROUP BY Department
ORDER BY AverageSalary DESC;


------------------------------------------------------------
-- Query 6 : Running Total of Salary
------------------------------------------------------------
SELECT
    EmployeeNumber,
    MonthlyIncome,
    SUM(MonthlyIncome) OVER
    (
        ORDER BY EmployeeNumber
    ) AS RunningSalaryTotal
FROM HR_Employee;


------------------------------------------------------------
-- Query 7 : Employees Above Company Average Experience
------------------------------------------------------------
SELECT
    EmployeeNumber,
    JobRole,
    TotalWorkingYears
FROM HR_Employee
WHERE TotalWorkingYears >
(
    SELECT AVG(TotalWorkingYears)
    FROM HR_Employee
)
ORDER BY TotalWorkingYears DESC;


------------------------------------------------------------
-- Query 8 : Highest Paid Employee in Each Job Role
------------------------------------------------------------
WITH HighestSalary AS
(
    SELECT
        EmployeeNumber,
        JobRole,
        MonthlyIncome,
        ROW_NUMBER() OVER
        (
            PARTITION BY JobRole
            ORDER BY MonthlyIncome DESC
        ) AS RN
    FROM HR_Employee
)
SELECT *
FROM HighestSalary
WHERE RN = 1;


------------------------------------------------------------
-- Query 9 : Company Salary Percentage
------------------------------------------------------------
SELECT
    EmployeeNumber,
    MonthlyIncome,
    ROUND(
        MonthlyIncome * 100.0 /
        SUM(MonthlyIncome) OVER (),
        2
    ) AS SalaryPercentage
FROM HR_Employee;


------------------------------------------------------------
-- Query 10 : Top 5 Most Experienced Employees
------------------------------------------------------------
SELECT TOP 5
    EmployeeNumber,
    Department,
    JobRole,
    TotalWorkingYears
FROM HR_Employee
ORDER BY TotalWorkingYears DESC;